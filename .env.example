# FlowRadio 环境变量配置
# 复制此文件为 .env 并填入你的 API Keys

# ===== 必需配置 =====

# 1. Gemini API (用于 Lyria 音乐生成) - 必需
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== 推荐配置 =====

# 2. Coze API Token (AI DJ 工作流 - 推荐使用)
# 获取地址: https://www.coze.cn/open/oauth/pats
# 功能: AI主持人播报 + 气氛组互动 + TTS语音
COZE_API_TOKEN=your_coze_api_token_here

# Coze 工作流 ID (已配置好,无需修改)
COZE_MAIN_WORKFLOW_ID=7580359385462505491
COZE_COMMENT_REPLY_WORKFLOW_ID=7580359385462521875

# ===== 可选配置 (Fallback模式) =====

# 3. 火山引擎豆包 API (仅在未配置 Coze 时使用)
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
# 注意: Coze 模式体验更好,推荐优先使用 Coze
VOLCANO_API_KEY=your_volcano_api_key_here
VOLCANO_ENDPOINT_ID=your_endpoint_id_here

# ===== 服务端口配置 =====

LYRIA_PORT=8000
GO_BACKEND_PORT=8080
GRPC_PORT=50051

# ===== 代理配置 (可选) =====

# 如果需要使用代理访问 Gemini/Coze
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890

# ===== 调试配置 =====

# Coze API 详细日志 (开发调试用)
# 启用后会实时显示所有 Coze API 的请求和响应
# COZE_VERBOSE=true


